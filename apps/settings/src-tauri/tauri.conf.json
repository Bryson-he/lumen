{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen",
  "version": "0.1.0",
  "identifier": "app.lumen.settings",
  "build": {
    "beforeDevCommand": "cargo build -p lumen-core && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo build --release -p lumen-core && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumen",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 560,
        "theme": null,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "One theme for your whole Windows desktop",
    "resources": {
      "../../../target/release/lumen-core.exe": "lumen-core.exe",
      "../../../gallery/": "gallery/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4RUJDM0JCMzIwMEZGNzAKUldSdy93QXl1OFByS0xSd3dKemZIVVVhK2ZwMXhpdFFaSGtPK0FYRmZ3eTZLQUEwUG9OeHJhS0EK",
      "endpoints": [
        "https://github.com/Bryson-he/lumen/releases/latest/download/latest.json"
      ]
    }
  }
}
